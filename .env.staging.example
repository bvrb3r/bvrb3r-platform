# Preview/staging environment template
# Copy to `.env.staging` for local staging builds or mirror these keys in Vercel Preview.
# Keep this file placeholder-only. Real secrets belong in Vercel/Supabase/Stripe/Twilio dashboards.

# App runtime configuration
NEXT_PUBLIC_APP_NAME=BVRB3R Platform
NEXT_PUBLIC_APP_URL=https://preview.bvrb3r.app
NEXT_PUBLIC_APP_LINK_SCHEME=bvrb3r
NEXT_PUBLIC_APP_RUNTIME=pwa
CAPACITOR_SERVER_URL=https://preview.bvrb3r.app
DELIVERY_ENVIRONMENT=preview
NEXT_PUBLIC_AUTH_MODE=supabase
PAYMENTS_PROVIDER=stripe

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-preview-or-production-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_MEDIA_BUCKET=bvrb3r-media
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Stripe preview must use test-mode values only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_preview_key_here
STRIPE_SECRET_KEY=sk_test_your_preview_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_preview_standard_webhook_secret_here
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_your_preview_connect_webhook_secret_here
STRIPE_IDENTITY_WEBHOOK_SECRET=whsec_your_preview_identity_webhook_secret_here

# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# Provide at least one sender path below.
TWILIO_MESSAGING_SERVICE_SID=your_twilio_messaging_service_sid_here
TWILIO_FROM_NUMBER=your_twilio_phone_number_here

# Resend
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=notifications@preview.bvrb3r.app

# Web push (VAPID)
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=your_preview_vapid_public_key_here
WEB_PUSH_PRIVATE_KEY=your_preview_vapid_private_key_here
WEB_PUSH_SUBJECT=mailto:owner@bvrb3r.app

# APNs
NEXT_PUBLIC_IOS_BUNDLE_ID=com.bvrb3r.platform.ios
IOS_TEAM_ID=YOURTEAMID
IOS_KEY_ID=YOURKEYID
IOS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APNS_USE_SANDBOX=true
NEXT_PUBLIC_APP_STORE_ID=

# Firebase Cloud Messaging
NEXT_PUBLIC_ANDROID_PACKAGE_NAME=com.bvrb3r.platform
ANDROID_SIGNING_SHA256=YOUR:ANDROID:SIGNING:FINGERPRINT
FCM_PROJECT_ID=bvrb3r-staging
FCM_CLIENT_EMAIL=firebase-adminsdk-fbsvc@bvrb3r-staging.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
FCM_SENDER_ID=your_fcm_sender_id_here
