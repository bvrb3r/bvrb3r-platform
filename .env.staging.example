# Staging environment template
# Copy to `.env.staging` and replace every placeholder before staging cutover.

# App runtime configuration
NEXT_PUBLIC_APP_NAME=BVRB3R Platform
NEXT_PUBLIC_APP_URL=https://staging.example.com
NEXT_PUBLIC_APP_LINK_SCHEME=bvrb3r
NEXT_PUBLIC_APP_RUNTIME=native_wrap_ready
CAPACITOR_SERVER_URL=https://staging.example.com
DELIVERY_ENVIRONMENT=staging
BVRB3R_OWNER_REVIEW_MODE=true
NEXT_PUBLIC_AUTH_MODE=supabase
PAYMENTS_PROVIDER=mock

# Stripe-backed split payments. Keep PAYMENTS_PROVIDER=mock until every value
# below and all three signed webhook endpoints are verified; then set it to
# stripe. Each destination must have its own signing secret; do not reuse or
# configure a fallback between destinations.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
# /api/stripe/webhook (Platform Money events only)
STRIPE_WEBHOOK_SECRET=whsec_placeholder
# /api/stripe/connect/webhook (Connected Account events only)
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_connect_placeholder
# /api/stripe/identity/webhook (Identity events only)
STRIPE_IDENTITY_WEBHOOK_SECRET=whsec_identity_placeholder

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-publishable-key
NEXT_PUBLIC_SUPABASE_MEDIA_BUCKET=bvrb3r-media
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key

# Twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Provide at least one sender path below.
TWILIO_MESSAGING_SERVICE_SID=your-twilio-messaging-service-sid
TWILIO_FROM_NUMBER=your-twilio-phone-number

# Resend
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=notifications.com
CRON_SECRET=replace-with-a-long-random-secret
AUTOMATION_PROCESS_SECRET=replace-with-a-separate-long-random-secret

# Mapbox (PR39)
NEXT_PUBLIC_MAPBOX_TOKEN=<mapbox-public-token>
NEXT_PUBLIC_MAPBOX_STYLE_DARK=mapbox://styles/mapbox/dark-v11
NEXT_PUBLIC_MAPBOX_STYLE_LIGHT=mapbox://styles/mapbox/light-v11
MAPBOX_SERVER_TOKEN=<mapbox-server-token>

# App ID (PR36)
APP_ID_SIGNING_SECRET=<app-id-signing-secret>
APP_ID_APPLE_WALLET_ISSUER_URL_TEMPLATE=<apple-wallet-issuer-url-with-token-placeholder>
APP_ID_GOOGLE_WALLET_ISSUER_URL_TEMPLATE=<google-wallet-issuer-url-with-token-placeholder>
GIFT_CARD_CLAIM_SECRET=<gift-card-claim-secret>
GROUP_PAYMENT_LINK_SECRET=<group-payment-link-secret>

# Calendar sync (PR33)
CALENDAR_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key
CALENDAR_SYNC_CRON_SECRET=replace-with-a-long-random-secret
SQUARE_APPLICATION_ID=your-square-application-id
SQUARE_APPLICATION_SECRET=your-square-application-secret
SQUARE_CALENDAR_REDIRECT_URI=https://staging.example.com/api/calendar-sync/square/oauth/callback
SQUARE_WEBHOOK_SIGNATURE_KEY=your-square-webhook-signature-key
SQUARE_CALENDAR_WEBHOOK_URL=https://staging.example.com/api/calendar-sync/square/webhook
GOOGLE_CALENDAR_CLIENT_ID=your-google-calendar-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-calendar-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=https://staging.example.com/api/calendar-sync/google/oauth/callback

# Web push (VAPID)
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=your-vapid-public-key
WEB_PUSH_PRIVATE_KEY=your-vapid-private-key
WEB_PUSH_SUBJECT=mailto:notifications.com

# APNs
NEXT_PUBLIC_IOS_BUNDLE_ID=com.bvrb3r.platform.ios
IOS_TEAM_ID=your-apple-team-id
IOS_KEY_ID=your-apple-key-id
IOS_PRIVATE_KEY=your-apns-private-key
APNS_USE_SANDBOX=true
# Optional for staging metadata if you already have an App Store Connect record.
NEXT_PUBLIC_APP_STORE_ID=

# Firebase Cloud Messaging
NEXT_PUBLIC_ANDROID_PACKAGE_NAME=com.bvrb3r.platform
ANDROID_SIGNING_SHA256=your-android-signing-sha256
FCM_PROJECT_ID=your-firebase-project-id
FCM_CLIENT_EMAIL=your-firebase-client-email
FCM_PRIVATE_KEY=your-firebase-private-key
FCM_SENDER_ID=your-firebase-sender-id
