# Staging environment template
# Copy to `.env.staging` and replace every placeholder before staging cutover.

# App runtime configuration
NEXT_PUBLIC_APP_NAME=BVRB3R Platform
NEXT_PUBLIC_APP_URL=https://staging.example.com
NEXT_PUBLIC_APP_LINK_SCHEME=bvrb3r
NEXT_PUBLIC_APP_RUNTIME=native_wrap_ready
CAPACITOR_SERVER_URL=https://staging.example.com
DELIVERY_ENVIRONMENT=staging
NEXT_PUBLIC_AUTH_MODE=supabase
PAYMENTS_PROVIDER=mock

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-publishable-key
NEXT_PUBLIC_SUPABASE_MEDIA_BUCKET=bvrb3r-media
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key

# Twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Provide at least one sender path below.
TWILIO_MESSAGING_SERVICE_SID=your-twilio-messaging-service-sid
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Resend
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=notifications.com

# Web push (VAPID)
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=your-vapid-public-key
WEB_PUSH_PRIVATE_KEY=your-vapid-private-key
WEB_PUSH_SUBJECT=mailto:notifications.com

# APNs
NEXT_PUBLIC_IOS_BUNDLE_ID=com.bvrb3r.platform.ios
IOS_TEAM_ID=your-apple-team-id
IOS_KEY_ID=your-apple-key-id
IOS_PRIVATE_KEY=your-apns-private-key
APNS_USE_SANDBOX=true
# Optional for staging metadata if you already have an App Store Connect record.
NEXT_PUBLIC_APP_STORE_ID=

# Firebase Cloud Messaging
NEXT_PUBLIC_ANDROID_PACKAGE_NAME=com.bvrb3r.platform
ANDROID_SIGNING_SHA256=your-android-signing-sha256
FCM_PROJECT_ID=your-firebase-project-id
FCM_CLIENT_EMAIL=your-firebase-client-email
FCM_PRIVATE_KEY=your-firebase-private-key
FCM_SENDER_ID=your-firebase-sender-id
