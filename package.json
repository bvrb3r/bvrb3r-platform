{
  "name": "bvrb3r-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:clean-port": "node scripts/dev-clean-port.mjs",
    "dev": "npm run dev:clean-port && node --env-file-if-exists=.env.local ./node_modules/next/dist/bin/next dev -p 3000",
    "dev:local": "npm run dev:clean-port && node --env-file-if-exists=.env.local ./node_modules/next/dist/bin/next dev -p 3000",
    "dev:staging": "npm run dev:clean-port && node --env-file-if-exists=.env.local --env-file-if-exists=.env.staging ./node_modules/next/dist/bin/next dev -p 3000",
    "dev:production": "npm run dev:clean-port && node --env-file-if-exists=.env.local --env-file-if-exists=.env.production ./node_modules/next/dist/bin/next dev -p 3000",
    "qa:app": "npm run dev:local",
    "qa:stripe": "node scripts/qa-stripe-listen.mjs",
    "qa:check": "node scripts/qa-check.mjs",
    "release:check": "node --env-file-if-exists=.env.local scripts/release-readiness.mjs",
    "prebuild": "npm run verify:deployment",
    "build": "node --env-file-if-exists=.env.local ./node_modules/next/dist/bin/next build",
    "build:local": "node --env-file-if-exists=.env.local ./node_modules/next/dist/bin/next build",
    "build:staging": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.staging ./node_modules/next/dist/bin/next build",
    "build:production": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.production ./node_modules/next/dist/bin/next build",
    "start": "node --env-file-if-exists=.env.local ./node_modules/next/dist/bin/next start",
    "start:local": "node --env-file-if-exists=.env.local ./node_modules/next/dist/bin/next start",
    "start:staging": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.staging ./node_modules/next/dist/bin/next start",
    "start:production": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.production ./node_modules/next/dist/bin/next start",
    "cap:build:web": "node scripts/build-capacitor-web.mjs",
    "cap:build:web:local": "node --env-file-if-exists=.env.local scripts/build-capacitor-web.mjs",
    "cap:build:web:staging": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.staging scripts/build-capacitor-web.mjs",
    "cap:build:web:production": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.production scripts/build-capacitor-web.mjs",
    "cap:sync": "node --env-file-if-exists=.env.local scripts/build-capacitor-web.mjs && node --env-file-if-exists=.env.local ./node_modules/@capacitor/cli/bin/capacitor sync",
    "cap:sync:local": "node --env-file-if-exists=.env.local scripts/build-capacitor-web.mjs && node --env-file-if-exists=.env.local ./node_modules/@capacitor/cli/bin/capacitor sync",
    "cap:sync:staging": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.staging scripts/build-capacitor-web.mjs && node --env-file-if-exists=.env.local --env-file-if-exists=.env.staging ./node_modules/@capacitor/cli/bin/capacitor sync",
    "cap:sync:production": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.production scripts/build-capacitor-web.mjs && node --env-file-if-exists=.env.local --env-file-if-exists=.env.production ./node_modules/@capacitor/cli/bin/capacitor sync",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "vitest run",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "verify:architect-metadata": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs scripts/verify-architect-metadata.ts",
    "seed": "tsx lib/data/seed.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:db:reset": "supabase db reset"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@hookform/resolvers": "^3.10.0",
    "@stripe/react-stripe-js": "^6.3.0",
    "@stripe/stripe-js": "^9.4.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "@tanstack/react-query": "^5.64.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "stripe": "^17.7.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.0.8",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.2.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
