NEXT_PUBLIC_APP_NAME=BVRB3R Platform
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_LINK_SCHEME=bvrb3r
NEXT_PUBLIC_APP_RUNTIME=pwa
CAPACITOR_SERVER_URL=
DELIVERY_ENVIRONMENT=development
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=BN-placeholder-public-key
WEB_PUSH_PRIVATE_KEY=placeholder-private-key
WEB_PUSH_SUBJECT=mailto:owner@bvrb3r.app
NEXT_PUBLIC_AUTH_MODE=demo
NEXT_PUBLIC_DEMO_ROLE=owner
NEXT_PUBLIC_DEMO_EMAIL=owner@bvrb3r.demo
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_MEDIA_BUCKET=bvrb3r-media
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PAYMENTS_PROVIDER=mock
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
TWILIO_ACCOUNT_SID=placeholder
TWILIO_AUTH_TOKEN=placeholder
TWILIO_FROM_NUMBER=+18135550111
TWILIO_MESSAGING_SERVICE_SID=placeholder
RESEND_API_KEY=re_placeholder
RESEND_FROM_EMAIL=notifications@bvrb3r.app
CRON_SECRET=replace-with-a-long-random-secret
GOOGLE_MAPS_API_KEY=placeholder
# PR39: the browser token must be URL-restricted. Permanent geocoding uses the
# separate server token and is never exposed through NEXT_PUBLIC_*.
NEXT_PUBLIC_MAPBOX_TOKEN=<mapbox-public-token>
NEXT_PUBLIC_MAPBOX_STYLE_DARK=mapbox://styles/mapbox/dark-v11
NEXT_PUBLIC_MAPBOX_STYLE_LIGHT=mapbox://styles/mapbox/light-v11
MAPBOX_SERVER_TOKEN=<mapbox-server-token>
# PR36 App ID. Keep signing material server-only; wallet templates must contain
# a literal {token} placeholder accepted by the signed-pass issuer.
APP_ID_SIGNING_SECRET=<app-id-signing-secret>
APP_ID_APPLE_WALLET_ISSUER_URL_TEMPLATE=<apple-wallet-issuer-url-with-token-placeholder>
APP_ID_GOOGLE_WALLET_ISSUER_URL_TEMPLATE=<google-wallet-issuer-url-with-token-placeholder>
GIFT_CARD_CLAIM_SECRET=<gift-card-claim-secret>
GROUP_PAYMENT_LINK_SECRET=<group-payment-link-secret>
# PR33 calendar sync. CALENDAR_TOKEN_ENCRYPTION_KEY must decode to 32 random
# bytes. Vercel cron can reuse CRON_SECRET; the dedicated value is accepted for
# manual/specialized schedulers.
CALENDAR_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key
CALENDAR_SYNC_CRON_SECRET=replace-with-a-long-random-secret
SQUARE_APPLICATION_ID=placeholder
SQUARE_APPLICATION_SECRET=placeholder
SQUARE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar-sync/square/oauth/callback
SQUARE_WEBHOOK_SIGNATURE_KEY=placeholder
SQUARE_CALENDAR_WEBHOOK_URL=http://localhost:3000/api/calendar-sync/square/webhook
GOOGLE_CALENDAR_CLIENT_ID=placeholder
GOOGLE_CALENDAR_CLIENT_SECRET=placeholder
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar-sync/google/oauth/callback
NEXT_PUBLIC_IOS_BUNDLE_ID=com.bvrb3r.platform.ios
IOS_TEAM_ID=placeholder
IOS_KEY_ID=placeholder
IOS_PRIVATE_KEY=placeholder
APNS_USE_SANDBOX=true
NEXT_PUBLIC_ANDROID_PACKAGE_NAME=com.bvrb3r.platform
ANDROID_SIGNING_SHA256=placeholder
NEXT_PUBLIC_APP_STORE_ID=placeholder
FCM_PROJECT_ID=placeholder
FCM_CLIENT_EMAIL=placeholder
FCM_PRIVATE_KEY=placeholder
FCM_SENDER_ID=placeholder

# Local-only seeded kiosk fixture.
# Set to "true" to render the full shop/barber kiosk mission from an in-memory
# fixture — no Supabase row, no Stripe, no device session. Ignored entirely when
# NODE_ENV=production. Leave unset everywhere except a local machine.
#   Shop kiosk:   /kiosk/shop/kiosk-local-fixture-shop
#   Barber kiosk: /kiosk/barber/kiosk-local-fixture-barber
#   Staff exit PIN: 2468
KIOSK_LOCAL_FIXTURE=
